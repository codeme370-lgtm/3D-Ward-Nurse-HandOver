generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WardAccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  staffNumber   String?   @unique
  password      String
  role          String    @default("Ward staff")
  accountStatus String    @default("ACTIVE")
  lastSignInAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WardAccessRequest {
  id                      String   @id @default(cuid())
  name                    String
  staffNumber             String   @unique
  email                   String   @unique
  requestedRole           String
  ward                    String   @default("Ward 3D")
  approverName            String
  passwordHash            String
  trainingCompleted       Boolean  @default(false)
  confidentialityAccepted Boolean  @default(false)
  acceptedAt              DateTime
  status                  WardAccessRequestStatus @default(PENDING)
  grantedRole             String?
  decisionReason          String?
  approvedById            String?
  requestedAt             DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([status, requestedAt])
}

model WardHandover {
  id              String   @id @default(cuid())
  handoverDate    DateTime @db.Date
  shift           String
  nurseInChargeId String
  status          String   @default("IN_PROGRESS")
  payload         Json     @default("{}")
  formVersion     String   @default("1")
  outgoingNicId   String?
  incomingNicId   String?
  signedOffAt     DateTime?
  pdfData         Bytes?
  pdfGeneratedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([handoverDate, shift])
  @@index([status, handoverDate])
}

model WardAuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  action      String
  recordId    String?
  device      String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail, createdAt])
  @@index([recordId, createdAt])
}

model WardConfiguration {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WardSession {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}
